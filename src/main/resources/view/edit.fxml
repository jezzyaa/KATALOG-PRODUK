<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1000" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EditController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
            <Label styleClass="title" text="Edit Produk" />
            <Button onAction="#kembali" styleClass="button-secondary" text="Kembali" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToHeight="false" fitToWidth="true">
            <content>
                <VBox styleClass="katalog">
                    <VBox maxWidth="520" spacing="10" styleClass="kartu-produk">
                        <Label fx:id="idLabel" styleClass="muted" />
                        <StackPane fx:id="previewPane" />
                        <Label text="Nama produk" />
                        <TextField fx:id="namaField" />
                        <Label text="Harga (Rp)" />
                        <TextField fx:id="hargaField" />
                        <Label text="Foto produk" />
                        <ComboBox fx:id="fotoBox" maxWidth="Infinity" onAction="#fotoDipilih" />
                        <HBox spacing="8">
                            <Button onAction="#simpanPerubahan" styleClass="button-primary" text="Simpan Perubahan" />
                            <Button onAction="#hapusProduk" styleClass="button-danger" text="Hapus Produk" />
                        </HBox>
                        <Label fx:id="pesanLabel" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
